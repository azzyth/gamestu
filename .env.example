# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only. Needed for cron jobs (weekly summary, syncs,
# retraining) and the public share page. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Notifications ---
# Resend (weekly summary emails). Skip to disable email.
RESEND_API_KEY=
SUMMARY_EMAIL_FROM=onboarding@resend.dev
# Web Push VAPID keys (npx web-push generate-vapid-keys).
# The public key must be NEXT_PUBLIC_ so the browser can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gamestu.app

# --- ML service (Phase 2) ---
# Base URL of the FastAPI service (ml-service/). Skip to stay on the rules engine.
ML_SERVICE_URL=

# --- Integrations (Phase 2/3) ---
STEAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron (Vercel cron sends this as the Authorization bearer token) ---
CRON_SECRET=
